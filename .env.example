# Copy to .env and replace the values. Never commit .env.
# Use letters and digits only: passwords are embedded in connection URLs.

# PostgreSQL superuser (administration only; services never use it).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# One login role per service database (<svc>_user on <svc>_db).
AUTH_DB_PASSWORD=change-me
FLAGS_DB_PASSWORD=change-me
TARGETING_DB_PASSWORD=change-me

MASTER_KEY=change-me

# Created after auth-service is up (POST /admin/keys with MASTER_KEY).
SERVICE_API_KEY=change-me


# Local AWS emulators (ElasticMQ for SQS, DynamoDB Local).
SQS_QUEUE_NAME=togglemaster-evaluations
DYNAMODB_TABLE=ToggleMasterAnalytics

